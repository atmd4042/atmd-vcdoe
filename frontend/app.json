{
  "expo": {
    "name": "اعتمد",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.providerclientapp.k2rih2",
      "infoPlist": {
        "NSCameraUsageDescription": "لتصوير مستندات النشاط التجاري",
        "NSPhotoLibraryUsageDescription": "لإرفاق صور الخدمات والمستندات"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.providerclientapp.k2rih2",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "للسماح باختيار صور الخدمات والمستندات",
          "cameraPermission": "لتصوير مستندات النشاط التجاري"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
